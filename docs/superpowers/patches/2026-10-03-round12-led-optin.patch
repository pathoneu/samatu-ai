index 0000000..28d830a
--- /dev/null
+++ b/backend/tests/test_led_estimate_choice_2026_10_03.py
@@ -0,0 +1,71 @@
+"""Part B of the 2026-10-03 LED fix (audit vision-pipeline-1): an LED niche
+length estimated from the room type is not billed until he accepts it.
+
+Behind `niche_inference.LED_ESTIMATE_OPT_IN`. Measured on the corpus before it
+was kept or dropped — see docs/superpowers/patches/2026-10-03-round12-led-optin.patch.
+"""
+from __future__ import annotations
+
+import copy
+
+import pytest
+
+from extractor import niche_inference
+from extractor.vision_call import (
+    _build_pozicijos_from_rooms, _recompute_per_room_via_python,
+)
+
+
+def _parsed() -> dict:
+    return {
+        "patalpos": [
+            {"nr": "01", "pavadinimas": "Svetainė", "paskirtis": "gyvenamoji",
+             "plotas_m2": 30.0, "perimetras_m": 22.0, "lubu_aukstis_m": 2.7,
+             "elementai": [{"tipas": "nisa_LED", "kiekis": 1, "ilgis_m": 8.0,
+                            "_source": "niche_locator"}]},
+            {"nr": "02", "pavadinimas": "Koridorius", "paskirtis": "koridorius",
+             "plotas_m2": 8.0, "perimetras_m": 12.0, "lubu_aukstis_m": 2.7,
+             "elementai": [{"tipas": "nisa_LED", "kiekis": 1, "ilgis_m": 6.6,
+                            "_source": "statistical_inference", "_confidence": "low"}]},
+        ],
+        "santrauka": {},
+    }
+
+
+def _rows(parsed: dict, overrides: dict | None = None) -> list[dict]:
+    p = copy.deepcopy(parsed)
+    if overrides:
+        p["_overrides"] = overrides
+    p = _recompute_per_room_via_python(p, overrides or {})
+    return _build_pozicijos_from_rooms(p)["pozicijos"]
+
+
+@pytest.fixture(autouse=True)
+def _opt_in(monkeypatch):
+    monkeypatch.setattr(niche_inference, "LED_ESTIMATE_OPT_IN", True)
+
+
+def test_the_estimate_waits_for_his_answer():
+    rows = _rows(_parsed())
+    framing = next(r for r in rows if r["aprasymas"] == "Nišų formavimas GKP konstrukcijoje")
+    assert framing["kiekis"] == 8.0                       # read metres only
+    blank = next(r for r in rows if r["aprasymas"] == "LED nišos — suveskite ilgį")
+    assert blank["kiekis"] is None and blank["saltinis"] == "checklist"
+    assert "02" in blank["_confidence_reason"] and "6,60" in blank["_confidence_reason"]
+    assert blank["_led_ivertinta_m"] == 6.6
+
+
+def test_accepting_the_estimate_bills_it_and_discloses_it():
+    rows = _rows(_parsed(), {niche_inference.LED_ESTIMATE_CHOICE_KEY: True})
+    framing = next(r for r in rows if r["aprasymas"] == "Nišų formavimas GKP konstrukcijoje")
+    assert framing["kiekis"] == pytest.approx(14.6)
+    assert framing["confidence"] != "zalia" and "02 (6,60 m)" in framing["_confidence_reason"]
+    assert not any(r["aprasymas"] == "LED nišos — suveskite ilgį" for r in rows)
+
+
+def test_off_bills_the_estimate_like_before(monkeypatch):
+    monkeypatch.setattr(niche_inference, "LED_ESTIMATE_OPT_IN", False)
+    rows = _rows(_parsed())
+    framing = next(r for r in rows if r["aprasymas"] == "Nišų formavimas GKP konstrukcijoje")
+    assert framing["kiekis"] == pytest.approx(14.6)
+    assert not any(r["aprasymas"] == "LED nišos — suveskite ilgį" for r in rows)
