# Sąmatų AI — backend environment template
# Copy to backend/.env (NEVER commit), fill in real values.
# Loaded automatically via python-dotenv on uvicorn start.

# ─── Required for production ──────────────────────────────────────────────────

# Anthropic Claude API key — used for PDF extraction (Vision pass-1, pass-2 zoom)
# Rotate via https://console.anthropic.com/settings/keys
# CRITICAL: never paste this in commits, screenshots, or chat logs.
ANTHROPIC_API_KEY=sk-ant-...

# Session signing secret — 32+ bytes random.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Rotation invalidates ALL existing sessions (users get logged out — by design).
SAMATU_SECRET_KEY=change-me-CHANGE-ME-32-bytes-min

# Environment hint for hardening checks. One of: development | staging | production
ENV=development

# ─── Optional ──────────────────────────────────────────────────────────────────

# Database location (default: ./samatu.db relative to backend/).
# In production, point at a persistent volume.
# SAMATU_DB_PATH=/var/lib/samatu/samatu.db

# Google OAuth — optional. When BOTH client id and secret are set, the
# "Prisijungti su Google" button appears on /login and /register.
# Setup:
#   1. https://console.cloud.google.com/apis/credentials → Create OAuth client
#   2. Application type: Web application
#   3. Authorized redirect URI: https://your-domain/api/auth/google/callback
#   4. Copy client id + secret here.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Per-user Vision API spend cap (EUR/day). Default: no cap.
# Recommended for beta: 0.50 (caps each user at ~5 extractions/day).
# SAMATU_USER_DAILY_SPEND_EUR=0.50

# Per-user rate limit (extractions/hour). Default: 20.
# SAMATU_USER_HOURLY_EXTRACTS=20

# Feature flags (default-off unless noted).
# Set to "1" to enable, "0" to disable.
# ENABLE_POLYGON_PREPASS=1   # Sprint 4 Block B — wall_adjacency math (default ON)
# ENABLE_VERIFY_PASS=0       # Sprint 3 Opus self-verify
# ENABLE_PER_ROOM_CEILING=0  # Sprint 0 fix 4

# ─── Dev-only — DO NOT USE IN PRODUCTION ───────────────────────────────────────

# Bypass authentication entirely. Hard-fails if combined with ENV=production.
# SAMATU_AUTH_DISABLED=0
