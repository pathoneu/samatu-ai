# Anthropic Vision (extraction) — required
ANTHROPIC_API_KEY=

# Auth: set to 1 ONLY in local single-tenant dev. NEVER in production.
SAMATU_AUTH_DISABLED=
# Signed-cookie secret — required in production (app refuses to boot on the dev default).
SAMATU_SECRET_KEY=

# ── Durable PDF storage (Cloudflare R2, S3-compatible) ──────────────────────
# When all four are set, uploaded PDFs persist to R2; otherwise they fall back to
# a local directory (backend/data/pdf_store) — fine for dev, not durable for prod.
# Get these from Cloudflare → R2 Object Storage → Manage R2 API Tokens.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=samatu-pdfs

# ── Per-user Vision spend cap (optional; off when unset/0) ──────────────────
SAMATU_USER_DAILY_SPEND_EUR=
SAMATU_USER_HOURLY_EXTRACTS=

# ── Billing (W3) — DORMANT by default. See docs/billing.md for the runbook. ──
# The whole subsystem is a hard no-op unless BILLING_ENABLED is exactly "1":
# no quota check, no paywall, no Stripe calls, no pricing UI. Leave OFF until
# the go-live checklist in docs/billing.md is done.
BILLING_ENABLED=0
# Quota carry-over policy. "expire" (default, use-it-or-lose-it) is the ONLY one
# implemented; "rollover_1"/"rollover_3" are placeholders (rolled_over_credits
# returns 0). Leave as expire.
BILLING_QUOTA_POLICY=expire

# Stripe — test keys (sk_test_… / whsec_…) while validating, live keys at launch.
STRIPE_SECRET_KEY=            # sk_test_... then sk_live_... — server-side secret
STRIPE_WEBHOOK_SECRET=        # whsec_... — from `stripe listen` or the dashboard webhook
STRIPE_PRICE_PRO=             # price_... for the Pro €49/mo recurring Price
STRIPE_PRICE_STUDIO=          # price_... for the Studio €149/mo recurring Price
STRIPE_PRICE_ONEOFF=          # price_... for the one-off €12 one-time Price

# Frontend base URL for Checkout success/cancel redirects (no trailing slash).
PATHON_APP_URL=http://localhost:5173

# ── Invoice supplier block (Pathon legal identity, printed on every PVM
# sąskaita-faktūra). Any field left blank is simply omitted from the PDF.
# Leaving PATHON_COMPANY_PVM blank marks Pathon as NOT VAT-registered (under the
# €45k threshold) → invoices print "Pardavėjas nėra PVM mokėtojas" with no VAT
# line. Set it once Pathon registers for PVM.
PATHON_COMPANY_NAME=          # e.g. MB Pathon
PATHON_COMPANY_CODE=          # įmonės kodas (numeric)
PATHON_COMPANY_PVM=           # PVM kodas, e.g. LT100012345678 (blank = not registered)
PATHON_COMPANY_ADDRESS=       # registered address
PATHON_COMPANY_IBAN=          # payout IBAN, printed as "Apmokėti į sąskaitą"
PATHON_COMPANY_EMAIL=         # contact email on the invoice
